# KrishiSetu Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://krishisetu:krishisetu_dev@localhost:5432/krishisetu?schema=public

# Authentication
JWT_SECRET=krishisetu_super_secret_jwt_key_2026_production_change
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Python AI Service Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-ai-service-key

# Redis (Optional / Cache)
REDIS_URL=redis://localhost:6379

# Weather Provider ('mock' or 'openweathermap')
WEATHER_PROVIDER=mock
WEATHER_API_KEY=

# LLM Provider ('ollama', 'gemini', 'openai', 'none')
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
